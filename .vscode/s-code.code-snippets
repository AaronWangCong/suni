{
  // Place your Gotofreight-UC 工作区 snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  "defineOptions模板": {
    "prefix": "de-op",
    "body": ["defineOptions({\n name:'$TM_FILENAME_BASE'\n})", "$0"],
    "description": "defineOptions"
  },
  "vue3Setup的模板": {
    "prefix": "setup3",
    "body": [
      "<script lang='ts' setup>",
      "\tdefineOptions({\n name:'$TM_FILENAME_BASE'\n})",
      "</script>",
      "\t",
      "<template>",
      "\t<div class=\"$TM_FILENAME_BASE-container\">",
      "\t  <div class=\"sjzy-box\">",
      "\t    $TM_FILENAME_BASE",
      "\t  </div>",
      "\t</div>",
      "</template>",
      "\t",
      "<style lang=\"scss\" scoped>",
      ".$TM_FILENAME_BASE{",
      "   width:100%;",
      "   height:100%",
      "}",
      "</style>"
    ],
    "description": "vue3Setup的模板"
  },
  "scss": {
    "prefix": "scss",
    "body": ["<style lang=\"scss\" scoped>", ".$TM_FILENAME_BASE{", "   width:100%;", "}", "</style>"],
    "description": "根据文件名生产scss模块"
  },
  "uni-app模版": {
    "prefix": "unisetup",
    "body": [
      "<script lang='ts' setup>",
      "import { useDesign } from '@/hooks/useDesign'",
      "\t",
      "const { prefixCls } = useDesign('$0')",
      "</script>",
      "\t",
      "<template>",
      "\t<view :class=\"prefixCls\">",
      "\t",
      "\t</view>",
      "</template>",
      "\t",
      "<style lang=\"scss\" scoped>",
      "\t.sjzy-$0 {",
      "\t\twidth:100%;",
      "\t\theight:100%",
      "\t}",
      "</style>"
    ],
    "description": "uni-app模版"
  }
}
